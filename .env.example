# Copy to .env and fill from your credential store. Never commit .env.

STAFF_URL=https://staff.nexletta.com
VETERAN_URL=https://app.nexletta.com
PROVIDER_URL=https://providers.nexletta.com

# Signed in once per run by tests/auth.setup.ts. Every P1 check needs these three.
# VETERAN and PROVIDER must be the records named in tests/support/test-data.ts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
VETERAN_EMAIL=
VETERAN_PASSWORD=
PROVIDER_EMAIL=
PROVIDER_PASSWORD=

# Other roles. Not used by the current checks; fill them when a check needs one.
SCHEDULER_EMAIL=
SCHEDULER_PASSWORD=
BILLER_EMAIL=
BILLER_PASSWORD=
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
ORGANIZATION_EMAIL=
ORGANIZATION_PASSWORD=
REPRESENTATIVE_EMAIL=
REPRESENTATIVE_PASSWORD=
