{
  "name": "production-blockers-p1",
  "private": true,
  "description": "Playwright checks that verify Nexletta P1 production blockers.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:list": "playwright test --list",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
